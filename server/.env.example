NODE_ENV=production
PORT=5000
DATABASE_URL=postgres://username:password@host:5432/edunex
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
CLIENT_URL=https://your-frontend-domain.example
AI_SERVICE_URL=https://your-ai-service.example
JSON_BODY_LIMIT=2mb
URLENCODED_BODY_LIMIT=2mb
UPLOADS_DIR=./uploads
# Keep local for development; use supabase for cloud deployments.
STORAGE_MODE=local
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_secret
SUPABASE_STORAGE_BUCKET=edunex-files
# One-time local -> Supabase migration only. Never commit real credentials.
LOCAL_DATABASE_URL=postgres://username:password@localhost:5432/edunex
SUPABASE_DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM=EduNex <onboarding@resend.dev>
PASSWORD_RESET_URL=http://localhost:5173
