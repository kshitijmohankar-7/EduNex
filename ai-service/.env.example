# Gemini API key for the EduNex student AI assistant and RAG embeddings
GEMINI_API_KEY=your_gemini_api_key_here

# Main generation model
GEMINI_MODEL=gemini-3.6-flash

# RAG embedding model. Re-index materials if this model is changed.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# Local persistent Chroma configuration
CHROMA_PATH=./chroma_store
CHROMA_COLLECTION=study_materials_v2
